<%@ page pageEncoding="UTF-8" %>
<%--
  Thanh điều hướng. Mục hiển thị theo vai trò của người đang đăng nhập.
  Ẩn mục ở đây chỉ để giao diện gọn — quyền thật sự do bộ lọc phía máy chủ quyết định.
--%>
<header class="app-header">
  <div class="inner">
    <a class="brand" href="${ctx}/"><span aria-hidden="true">🍔</span> Fast Food</a>

    <%-- Ẩn sẵn; app.js bỏ hidden khi chạy được. Tắt JavaScript thì nút không hiện ra và
         thanh điều hướng vẫn nằm nguyên, chứ không thành cái nút bấm mãi không mở. --%>
    <button type="button" class="nav-toggle" id="nav-toggle" hidden
            aria-expanded="false" aria-controls="main-nav" aria-label="Hiện hoặc ẩn menu điều hướng">☰</button>

    <nav id="main-nav" aria-label="Điều hướng chính">
      <c:choose>
        <c:when test="${empty me or me.roleName eq 'CUSTOMER'}">
          <a href="${ctx}/menu" class="${nav eq 'menu' ? 'active' : ''}" ${nav eq 'menu' ? 'aria-current="page"' : ''}>Thực đơn</a>
          <c:if test="${not empty me}">
            <a href="${ctx}/cart" class="${nav eq 'cart' ? 'active' : ''}" ${nav eq 'cart' ? 'aria-current="page"' : ''}>Giỏ hàng</a>
            <a href="${ctx}/order/history" class="${nav eq 'orders' ? 'active' : ''}" ${nav eq 'orders' ? 'aria-current="page"' : ''}>Đơn của tôi</a>
          </c:if>
        </c:when>

        <c:when test="${me.roleName eq 'CASHIER'}">
          <a href="${ctx}/staff/pos" class="${nav eq 'pos' ? 'active' : ''}" ${nav eq 'pos' ? 'aria-current="page"' : ''}>Bán tại quầy</a>
          <%-- Tra mã nhận hàng nằm ngay đầu màn Đơn hàng, không còn mục riêng. --%>
          <a href="${ctx}/staff/orders" class="${nav eq 'orders' ? 'active' : ''}" ${nav eq 'orders' ? 'aria-current="page"' : ''}>Đơn hàng</a>
          <a href="${ctx}/staff/counter" class="${nav eq 'counter' ? 'active' : ''}" ${nav eq 'counter' ? 'aria-current="page"' : ''}>Quầy giao nhận</a>
          <a href="${ctx}/staff/history" class="${nav eq 'history' ? 'active' : ''}" ${nav eq 'history' ? 'aria-current="page"' : ''}>Lịch sử</a>
        </c:when>

        <c:when test="${me.roleName eq 'KITCHEN'}">
          <%-- Hàng chờ và việc của mình nằm chung một trang: đầu bếp không phải chuyển qua lại. --%>
          <a href="${ctx}/kitchen/queue" class="${nav eq 'queue' ? 'active' : ''}" ${nav eq 'queue' ? 'aria-current="page"' : ''}>Bếp</a>
          <a href="${ctx}/kitchen/issue" class="${nav eq 'issue' ? 'active' : ''}" ${nav eq 'issue' ? 'aria-current="page"' : ''}>Sự cố</a>
          <a href="${ctx}/kitchen/history" class="${nav eq 'history' ? 'active' : ''}" ${nav eq 'history' ? 'aria-current="page"' : ''}>Đã hoàn thành</a>
        </c:when>

        <c:otherwise>
          <a href="${ctx}/admin/dashboard" class="${nav eq 'dashboard' ? 'active' : ''}" ${nav eq 'dashboard' ? 'aria-current="page"' : ''}>Tổng quan</a>
          <a href="${ctx}/admin/products" class="${nav eq 'products' ? 'active' : ''}" ${nav eq 'products' ? 'aria-current="page"' : ''}>Món ăn</a>
          <a href="${ctx}/admin/categories" class="${nav eq 'categories' ? 'active' : ''}" ${nav eq 'categories' ? 'aria-current="page"' : ''}>Nhóm món</a>
          <a href="${ctx}/admin/users" class="${nav eq 'users' ? 'active' : ''}" ${nav eq 'users' ? 'aria-current="page"' : ''}>Tài khoản</a>
          <a href="${ctx}/admin/audit" class="${nav eq 'audit' ? 'active' : ''}" ${nav eq 'audit' ? 'aria-current="page"' : ''}>Nhật ký</a>
        </c:otherwise>
      </c:choose>
    </nav>

    <div class="user-box">
      <c:choose>
        <c:when test="${empty me}">
          <a class="btn btn-sm" href="${ctx}/register">Đăng ký</a>
          <a class="btn btn-sm btn-primary" href="${ctx}/login">Đăng nhập</a>
        </c:when>
        <c:otherwise>
          <span class="who">
            <c:out value="${me.fullName}"/> · <span class="tag">${ff:roleName(me.roleName)}</span>
          </span>
          <a href="${ctx}/profile" class="btn btn-sm">Tài khoản</a>
          <a href="${ctx}/logout" class="btn btn-sm">Thoát</a>
        </c:otherwise>
      </c:choose>
    </div>
  </div>
</header>
